                  "value": "Adiciona %lld jogos"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Adiciona %lld jogo"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Adiciona %lld jogos"
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld oyun eklenecek"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld oyun eklenecek"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
