    "PS3 system software. Arcadia downloads it from Sony when you first play.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامج نظام PS3. يُنزّله Arcadia من Sony عند أول تشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Software del sistema de PS3. Arcadia lo descarga de Sony la primera vez que juegas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logiciel système PS3. Arcadia le télécharge depuis Sony la première fois que vous jouez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS3 सिस्टम सॉफ़्टवेयर। पहली बार खेलने पर Arcadia इसे Sony से डाउनलोड करता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Software do sistema do PS3. O Arcadia baixa da Sony na primeira vez que você joga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS3 sistem yazılımı. Arcadia ilk oynadığında onu Sony’den indirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PS3 系统软件。首次游玩时，Arcadia 会从 Sony 下载。"
          }
        }
      }
    },
