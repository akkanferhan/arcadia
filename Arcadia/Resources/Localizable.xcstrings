    "Pick a console, double-click a game and play. Arcadia installs the emulator for you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر جهازًا، وانقر نقرًا مزدوجًا على لعبة والعب. يثبّت Arcadia المحاكي نيابةً عنك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una consola, haz doble clic en un juego y a jugar. Arcadia instala el emulador por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une console, double-cliquez sur un jeu et jouez. Arcadia installe l’émulateur pour vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कंसोल चुनें, गेम पर डबल-क्लिक करें और खेलें। Arcadia आपके लिए एम्युलेटर इंस्टॉल करता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um console, clique duas vezes em um jogo e jogue. O Arcadia instala o emulador para você."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir konsol seç, oyuna çift tıkla ve oyna. Emülatörü Arcadia senin için yükler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一台主机，双击游戏即可开玩。Arcadia 会为你安装模拟器。"
          }
        }
      }
    },
