        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BIOS ज़रूरी है। इसे एम्युलेटर पेज पर छोड़ें या bios फ़ोल्डर में रखें।"
          }
        },
        "pt-BR": {
