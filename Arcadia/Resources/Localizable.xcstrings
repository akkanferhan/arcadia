    "Put a PS1 BIOS (e.g. scph5501.bin) in bios/ps1.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع ملف BIOS لجهاز PS1 (مثل scph5501.bin) في bios/ps1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon una BIOS de PS1 (p. ej., scph5501.bin) en bios/ps1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez un BIOS PS1 (par ex. scph5501.bin) dans bios/ps1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS1 BIOS (जैसे scph5501.bin) को bios/ps1 में रखें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque uma BIOS de PS1 (ex.: scph5501.bin) em bios/ps1."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir PS1 BIOS’unu (ör. scph5501.bin) bios/ps1 klasörüne koy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 PS1 BIOS（如 scph5501.bin）放入 bios/ps1。"
          }
        }
      }
    },
    "Put sega_101.bin and mpr-17933.bin in bios/.": {
      "localizations": {
        "ar": {
