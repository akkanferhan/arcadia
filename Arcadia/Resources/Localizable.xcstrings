    "Add games to your library folder and they'll show up here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ألعابًا إلى مجلد مكتبتك وستظهر هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade juegos a la carpeta de tu biblioteca y aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des jeux au dossier de votre bibliothèque et ils apparaîtront ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लाइब्रेरी फ़ोल्डर में गेम जोड़ें, वे यहाँ दिखाई देंगे।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione jogos à pasta da sua biblioteca e eles aparecerão aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kütüphane klasörüne oyun ekle, burada görünsünler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将游戏添加到游戏库文件夹，它们就会显示在这里。"
