{
  "sourceLanguage": "en",
  "strings": {
    "%@ is not installed yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ غير مثبّت بعد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aún no está instalado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas encore installé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अभी इंस्टॉल नहीं है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ ainda não está instalado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ henüz yüklü değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未安装。"
          }
        }
      }
    },
    "%@ plays %@ games. Install it now? It's free and takes about a minute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل ألعاب %2$@ باستخدام %1$@. هل تريد تثبيته الآن؟ إنه مجاني ويستغرق دقيقة تقريبًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos de %2$@ se juegan con %1$@. ¿Instalarlo ahora? Es gratis y tarda alrededor de un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeux %2$@ se lancent avec %1$@. L’installer maintenant ? C’est gratuit et cela prend environ une minute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ गेम %1$@ से चलते हैं। क्या अभी इंस्टॉल करें? यह मुफ़्त है और लगभग एक मिनट लेता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os jogos de %2$@ rodam no %1$@. Instalar agora? É grátis e leva cerca de um minuto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ oyunları %1$@ ile oynanır. Şimdi yüklensin mi? Ücretsizdir ve yaklaşık bir dakika sürer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 游戏需要 %1$@ 运行。现在安装吗？它是免费的，大约需要一分钟。"
          }
        }
      }
    },
    "%@ with a %lld-core GPU. Arcadia tunes every emulator for this Mac; games render at %lld× their original resolution.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ مع وحدة رسوميات من %2$lld نواة. يضبط Arcadia كل محاكٍ لهذا الـ Mac؛ وتُعرض الألعاب بدقة تبلغ %3$lld× دقتها الأصلية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ con GPU de %2$lld núcleos. Arcadia ajusta cada emulador para este Mac; los juegos se renderizan a %3$lld× su resolución original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ avec un GPU %2$lld cœurs. Arcadia règle chaque émulateur pour ce Mac ; les jeux sont rendus à %3$lld× leur résolution d’origine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld-कोर GPU के साथ। Arcadia हर एम्युलेटर को इस Mac के लिए ट्यून करता है; गेम अपने मूल रिज़ॉल्यूशन के %3$lld× पर रेंडर होते हैं।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ com GPU de %2$lld núcleos. O Arcadia ajusta cada emulador para este Mac; os jogos são renderizados em %3$lld× a resolução original."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld çekirdekli GPU. Arcadia her emülatörü bu Mac’e göre ayarlar; oyunlar orijinal çözünürlüklerinin %3$lld katında çizilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$lld 核 GPU。Arcadia 会针对这台 Mac 调整每个模拟器；游戏将以原始分辨率的 %3$lld 倍渲染。"
          }
        }
      }
    },
