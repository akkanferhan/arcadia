    "Games stay where they are; Arcadia adds links to them in your library.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الألعاب في مكانها؛ ويضيف Arcadia روابط إليها في مكتبتك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos se quedan donde están; Arcadia añade enlaces a ellos en tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeux restent à leur place ; Arcadia ajoute des liens vers eux dans votre bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेम अपनी जगह पर रहते हैं; Arcadia आपकी लाइब्रेरी में उनके लिंक जोड़ता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os jogos ficam onde estão; o Arcadia adiciona links para eles na sua biblioteca."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunlar yerinde kalır; Arcadia kütüphanene onlara giden bağlantılar ekler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏会保留在原处；Arcadia 只会在游戏库中添加指向它们的链接。"
          }
        }
      }
    },
