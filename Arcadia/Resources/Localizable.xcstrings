            "state": "translated",
            "value": "Oyun kumandası bağlanınca TV Modunu aç"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接手柄时打开电视模式"
          }
        }
      }
    },
    "Opens Arcadia and starts a game from your library.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Arcadia ويبدأ لعبة من مكتبتك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Arcadia e inicia un juego de tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Arcadia et lance un jeu de votre bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia खोलता है और आपकी लाइब्रेरी का एक गेम शुरू करता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Arcadia e inicia um jogo da sua biblioteca."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia’yı açar ve kütüphanendeki bir oyunu başlatır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Arcadia 并启动游戏库中的一款游戏。"
          }
        }
      }
    },
    "Opens Arcadia and starts the game you played last.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح Arcadia ويبدأ آخر لعبة لعبتها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Arcadia e inicia el último juego al que jugaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Arcadia et lance le dernier jeu auquel vous avez joué."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia खोलता है और पिछली बार खेला गया गेम शुरू करता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Arcadia e inicia o último jogo que você jogou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia’yı açar ve en son oynadığın oyunu başlatır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Arcadia 并启动你上次玩的游戏。"
          }
        }
      }
    },
