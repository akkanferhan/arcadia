          }
        }
      }
    },
    "Welcome to Arcadia": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا بك في Arcadia"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te damos la bienvenida a Arcadia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans Arcadia"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia में आपका स्वागत है"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Boas-vindas ao Arcadia"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia’ya Hoş Geldin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 Arcadia"
          }
        }
      }
    },
    "Where should Arcadia look?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين يبحث Arcadia؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde debe buscar Arcadia?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où Arcadia doit-il chercher ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia कहाँ खोजे?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde o Arcadia deve procurar?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia nerelere baksın?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia 应该在哪里查找？"
          }
        }
      }
    },
    "Which game do you want to play?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما اللعبة التي تريد لعبها؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿A qué juego quieres jugar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quel jeu voulez-vous jouer ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कौन-सा गेम खेलना चाहते हैं?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual jogo você quer jogar?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi oyunu oynamak istiyorsun?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想玩哪款游戏？"
          }
        }
      }
    },
    "Xbox": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox"
          }
        },
        "es": {
