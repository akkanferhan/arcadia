    "xemu needs the MCPX boot ROM, a flash BIOS and an HDD image (set in its settings).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج xemu إلى ذاكرة الإقلاع MCPX وملف BIOS فلاش وصورة قرص صلب (تُحدَّد في إعداداته)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "xemu necesita la ROM de arranque MCPX, una BIOS flash y una imagen de disco duro (se configuran en sus ajustes)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "xemu nécessite la ROM de démarrage MCPX, un BIOS flash et une image de disque dur (à définir dans ses réglages)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "xemu को MCPX बूट ROM, एक फ़्लैश BIOS और एक HDD इमेज चाहिए (इन्हें उसकी सेटिंग में चुनें)।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O xemu precisa da ROM de boot MCPX, de uma BIOS flash e de uma imagem de HD (definidas nas configurações dele)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "xemu; MCPX boot ROM, bir flash BIOS ve bir HDD imajı ister (kendi ayarlarından belirlenir)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "xemu 需要 MCPX 启动 ROM、Flash BIOS 和硬盘镜像（在其设置中指定）。"
          }
        }
      }
    },
    "·": {
      "shouldTranslate": false
    }
  },
  "version": "1.0"
