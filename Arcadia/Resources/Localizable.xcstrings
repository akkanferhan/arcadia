    "Put your games in a system's folder, or drag them onto a console page. Arcadia does the rest.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع ألعابك في مجلد النظام، أو اسحبها إلى صفحة الجهاز. وArcadia يتولى الباقي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tus juegos en la carpeta de un sistema o arrástralos a la página de una consola. Arcadia hace el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez vos jeux dans le dossier d’un système ou glissez-les sur la page d’une console. Arcadia s’occupe du reste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने गेम किसी सिस्टम के फ़ोल्डर में रखें, या उन्हें कंसोल पेज पर खींचें। बाकी काम Arcadia करता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque seus jogos na pasta de um sistema ou arraste-os para a página de um console. O Arcadia faz o resto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunlarını bir sistemin klasörüne koy ya da konsol sayfasına sürükle. Gerisini Arcadia halleder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把游戏放进对应平台的文件夹，或拖到主机页面上，其余的交给 Arcadia。"
          }
        }
      }
    },
