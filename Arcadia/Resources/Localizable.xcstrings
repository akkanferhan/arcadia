    "Open TV Mode when a controller connects": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح وضع التلفزيون عند توصيل وحدة تحكم"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir el modo TV al conectar un mando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir le mode TV lorsqu’une manette est connectée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंट्रोलर कनेक्ट होने पर TV मोड खोलें"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
