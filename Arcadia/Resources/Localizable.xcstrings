    "A PS2 BIOS dumped from your console (4 MB). There is no free replacement.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف BIOS لجهاز PS2 مستخرج من جهازك (4 ميغابايت). لا يوجد بديل مجاني."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una BIOS de PS2 extraída de tu consola (4 MB). No hay alternativa gratuita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un BIOS PS2 extrait de votre console (4 Mo). Il n’existe aucune alternative libre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कंसोल से निकाला गया PS2 BIOS (4 MB)। इसका कोई मुफ़्त विकल्प नहीं है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma BIOS de PS2 extraída do seu console (4 MB). Não existe alternativa gratuita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsolundan alınmış bir PS2 BIOS’u (4 MB). Ücretsiz bir alternatifi yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你自己的主机转储的 PS2 BIOS（4 MB），没有免费替代品。"
          }
        }
      }
    },
