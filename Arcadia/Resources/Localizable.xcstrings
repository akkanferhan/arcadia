    "BIOS needed. Drop it on the Emulators page or into the bios folder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم ملف BIOS. أفلته في صفحة المحاكيات أو ضعه في مجلد bios."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita la BIOS. Arrástrala a la página Emuladores o ponla en la carpeta bios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BIOS requis. Déposez-le sur la page Émulateurs ou dans le dossier bios."
          }
