    "Start games in full screen": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل الألعاب بملء الشاشة"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar los juegos en pantalla completa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer les jeux en plein écran"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेम फ़ुल स्क्रीन में शुरू करें"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar jogos em tela cheia"
