    "The MCPX boot ROM (512 bytes) and a flash BIOS from your Xbox. There is no free replacement.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرة الإقلاع MCPX (512 بايت) وملف BIOS فلاش من جهاز Xbox الخاص بك. لا يوجد بديل مجاني."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ROM de arranque MCPX (512 bytes) y una BIOS flash de tu Xbox. No hay alternativa gratuita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ROM de démarrage MCPX (512 octets) et un BIOS flash de votre Xbox. Il n’existe aucune alternative libre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Xbox से MCPX बूट ROM (512 बाइट) और एक फ़्लैश BIOS। इसका कोई मुफ़्त विकल्प नहीं है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ROM de boot MCPX (512 bytes) e uma BIOS flash do seu Xbox. Não existe alternativa gratuita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox’ından alınmış MCPX boot ROM’u (512 bayt) ve bir flash BIOS. Ücretsiz bir alternatifi yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自你的 Xbox 的 MCPX 启动 ROM（512 字节）和 Flash BIOS，没有免费替代品。"
          }
        }
      }
    },
    "The PS Vita system software download was damaged. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلف تنزيل برنامج نظام PS Vita. حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga del software del sistema de PS Vita está dañada. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement du logiciel système PS Vita est endommagé. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS Vita सिस्टम सॉफ़्टवेयर डाउनलोड खराब हो गया। फिर से कोशिश करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download do software do sistema do PS Vita foi corrompido. Tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS Vita sistem yazılımı indirmesi bozuk geldi. Tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PS Vita 系统软件下载已损坏，请重试。"
          }
        }
      }
    },
