            "state": "translated",
            "value": "Xbox"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox"
          }
        }
      }
    },
    "You haven't played any games in Arcadia yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تلعب أي لعبة في Arcadia بعد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has jugado a ningún juego en Arcadia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez encore joué à aucun jeu dans Arcadia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अभी तक Arcadia में कोई गेम नहीं खेला है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não jogou nenhum jogo no Arcadia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia’da henüz hiç oyun oynamadın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有在 Arcadia 中玩过任何游戏。"
          }
        }
      }
    },
    "Your controller now plays the game. Quit from the emulator to come back here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحكّم وحدة التحكم الآن في اللعبة. اخرج من المحاكي للعودة إلى هنا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora tu mando controla el juego. Sal desde el emulador para volver aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre manette contrôle maintenant le jeu. Quittez l’émulateur pour revenir ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आपका कंट्रोलर गेम चला रहा है। यहाँ वापस आने के लिए एम्युलेटर से बाहर निकलें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora seu controle está no jogo. Saia pelo emulador para voltar para cá."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun kumandan artık oyunu oynatıyor. Buraya dönmek için emülatörden çık."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的手柄现在用于控制游戏。从模拟器中退出即可回到这里。"
          }
        }
      }
    },
    "Your saves are kept in iCloud Drive, which isn't available right now. Sign in to iCloud and turn on iCloud Drive, or turn off save sync in Arcadia's settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ ملفات الحفظ في iCloud Drive، وهو غير متاح الآن. سجّل الدخول إلى iCloud وشغّل iCloud Drive، أو أوقف مزامنة ملفات الحفظ في إعدادات Arcadia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus partidas guardadas están en iCloud Drive, que no está disponible ahora mismo. Inicia sesión en iCloud y activa iCloud Drive, o desactiva la sincronización de partidas en los ajustes de Arcadia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos sauvegardes sont conservées dans iCloud Drive, qui n’est pas disponible pour le moment. Connectez-vous à iCloud et activez iCloud Drive, ou désactivez la synchronisation des sauvegardes dans les réglages d’Arcadia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सेव iCloud Drive में रखे गए हैं, जो अभी उपलब्ध नहीं है। iCloud में साइन इन करके iCloud Drive चालू करें, या Arcadia की सेटिंग्ज़ में सेव सिंक बंद करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus jogos salvos ficam no iCloud Drive, que não está disponível agora. Inicie sessão no iCloud e ative o iCloud Drive, ou desative a sincronização de jogos salvos nos ajustes do Arcadia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtların iCloud Drive’da tutuluyor ama iCloud Drive şu anda kullanılamıyor. iCloud’a giriş yapıp iCloud Drive’ı aç ya da Arcadia ayarlarında kayıt eşzamanlamayı kapat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的存档保存在 iCloud 云盘中，但 iCloud 云盘目前不可用。请登录 iCloud 并打开 iCloud 云盘，或在 Arcadia 设置中关闭存档同步。"
          }
        }
      }
    },
    "Your saves are still downloading from iCloud Drive. Check your internet connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال ملفات الحفظ قيد التنزيل من iCloud Drive. تحقّق من اتصالك بالإنترنت وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus partidas guardadas todavía se están descargando de iCloud Drive. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos sauvegardes sont encore en cours de téléchargement depuis iCloud Drive. Vérifiez votre connexion à Internet et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सेव अभी भी iCloud Drive से डाउनलोड हो रहे हैं। अपना इंटरनेट कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus jogos salvos ainda estão sendo baixados do iCloud Drive. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtların hâlâ iCloud Drive’dan indiriliyor. İnternet bağlantını kontrol edip tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的存档仍在从 iCloud 云盘下载。请检查你的互联网连接后重试。"
          }
        }
      }
    },
    "iCloud Drive": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 云盘"
          }
        }
      }
    },
    "iCloud Drive isn't available. Sign in to iCloud and turn on iCloud Drive in System Settings to sync your saves.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive غير متاح. سجّل الدخول إلى iCloud وشغّل iCloud Drive في إعدادات النظام لمزامنة ملفات الحفظ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive no está disponible. Inicia sesión en iCloud y activa iCloud Drive en Ajustes del Sistema para sincronizar tus partidas guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive n’est pas disponible. Connectez-vous à iCloud et activez iCloud Drive dans Réglages Système pour synchroniser vos sauvegardes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive उपलब्ध नहीं है। अपने सेव सिंक करने के लिए सिस्टम सेटिंग्ज़ में iCloud में साइन इन करें और iCloud Drive चालू करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud Drive não está disponível. Inicie sessão no iCloud e ative o iCloud Drive nos Ajustes do Sistema para sincronizar seus jogos salvos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive kullanılamıyor. Kayıtlarını eşzamanlamak için Sistem Ayarları’nda iCloud’a giriş yap ve iCloud Drive’ı aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 云盘不可用。请在“系统设置”中登录 iCloud 并打开 iCloud 云盘，以同步你的存档。"
          }
        }
      }
    },
    "macOS may ask whether Arcadia can open folders such as Desktop, Documents or Downloads. Allow it so games there can be found.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يسأل macOS ما إذا كان بإمكان Arcadia فتح مجلدات مثل سطح المكتب أو المستندات أو التنزيلات. اسمح بذلك ليتمكّن من العثور على الألعاب فيها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS puede preguntar si Arcadia puede abrir carpetas como Escritorio, Documentos o Descargas. Permítelo para encontrar los juegos que haya allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS peut demander si Arcadia peut ouvrir des dossiers comme Bureau, Documents ou Téléchargements. Autorisez-le pour que les jeux qui s’y trouvent soient trouvés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS पूछ सकता है कि क्या Arcadia डेस्कटॉप, दस्तावेज़ या डाउनलोड जैसे फ़ोल्डर खोल सकता है। वहाँ के गेम ढूँढने के लिए अनुमति दें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pode perguntar se o Arcadia pode abrir pastas como Mesa, Documentos ou Downloads. Permita para que os jogos ali sejam encontrados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, Arcadia’nın Masaüstü, Belgeler veya İndirilenler gibi klasörleri açıp açamayacağını sorabilir. Oradaki oyunların bulunabilmesi için izin ver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 可能会询问是否允许 Arcadia 打开“桌面”“文稿”或“下载”等文件夹。请允许，以便找到其中的游戏。"
          }
        }
      }
    },
    "sega_101.bin or mpr-17933.bin. Without it Arcadia uses a built-in BIOS; multi-disc games need the real one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "sega_101.bin أو mpr-17933.bin. بدونه يستخدم Arcadia نظام BIOS مدمجًا؛ وتحتاج الألعاب متعددة الأقراص إلى الأصلي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sega_101.bin o mpr-17933.bin. Sin ella, Arcadia usa una BIOS integrada; los juegos de varios discos necesitan la real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "sega_101.bin ou mpr-17933.bin. Sans lui, Arcadia utilise un BIOS intégré ; les jeux multidisques nécessitent le vrai."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "sega_101.bin या mpr-17933.bin। इसके बिना Arcadia बिल्ट-इन BIOS इस्तेमाल करता है; मल्टी-डिस्क गेम के लिए असली BIOS चाहिए।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "sega_101.bin ou mpr-17933.bin. Sem ela, o Arcadia usa uma BIOS embutida; jogos com vários discos precisam da original."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sega_101.bin veya mpr-17933.bin. Yoksa Arcadia yerleşik bir BIOS kullanır; çok diskli oyunlar gerçeğini ister."
