    "RetroAchievements sent an answer Arcadia couldn't read. Try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل RetroAchievements ردًّا لم يتمكّن Arcadia من قراءته. حاول مرة أخرى لاحقًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RetroAchievements envió una respuesta que Arcadia no pudo leer. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RetroAchievements a envoyé une réponse qu’Arcadia n’a pas pu lire. Réessayez plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "RetroAchievements ने ऐसा जवाब भेजा जिसे Arcadia पढ़ नहीं सका। बाद में फिर से कोशिश करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O RetroAchievements enviou uma resposta que o Arcadia não conseguiu ler. Tente novamente mais tarde."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RetroAchievements, Arcadia’nın okuyamadığı bir yanıt gönderdi. Daha sonra tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RetroAchievements 返回了 Arcadia 无法读取的响应。请稍后再试。"
          }
        }
      }
    },
