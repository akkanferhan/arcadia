        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस की गई कॉपी लिखने के लिए ड्राइव पर पर्याप्त खाली जगह नहीं है।"
          }
        },
        "pt-BR": {
