    "System software downloads from Sony the first time you play.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنزَّل برنامج النظام من Sony عند أول تشغيل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El software del sistema se descarga de Sony la primera vez que juegas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le logiciel système est téléchargé depuis Sony la première fois que vous jouez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहली बार खेलने पर सिस्टम सॉफ़्टवेयर Sony से डाउनलोड होता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O software do sistema é baixado da Sony na primeira vez que você joga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem yazılımı ilk oynadığında Sony’den indirilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次游玩时会从 Sony 下载系统软件。"
          }
        }
      }
    },
    "The MCPX boot ROM (512 bytes) and a flash BIOS from your Xbox. There is no free replacement.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرة الإقلاع MCPX (512 بايت) وملف BIOS فلاش من جهاز Xbox الخاص بك. لا يوجد بديل مجاني."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ROM de arranque MCPX (512 bytes) y una BIOS flash de tu Xbox. No hay alternativa gratuita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ROM de démarrage MCPX (512 octets) et un BIOS flash de votre Xbox. Il n’existe aucune alternative libre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Xbox से MCPX बूट ROM (512 बाइट) और एक फ़्लैश BIOS। इसका कोई मुफ़्त विकल्प नहीं है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ROM de boot MCPX (512 bytes) e uma BIOS flash do seu Xbox. Não existe alternativa gratuita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xbox’ından alınmış MCPX boot ROM’u (512 bayt) ve bir flash BIOS. Ücretsiz bir alternatifi yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自你的 Xbox 的 MCPX 启动 ROM（512 字节）和 Flash BIOS，没有免费替代品。"
          }
        }
      }
    },
    "The PS3 system software download was damaged. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلف تنزيل برنامج نظام PS3. حاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga del software del sistema de PS3 está dañada. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement du logiciel système PS3 est endommagé. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PS3 सिस्टम सॉफ़्टवेयर डाउनलोड खराब हो गया। फिर से कोशिश करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download do software do sistema do PS3 foi corrompido. Tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS3 sistem yazılımı indirmesi bozuk geldi. Tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PS3 系统软件下载已损坏，请重试。"
          }
        }
      }
    },
    "The download did not contain a Mac app.": {
