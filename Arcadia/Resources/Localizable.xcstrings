    "Compressed. The original could not be moved to the Trash.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الضغط. تعذّر نقل الملف الأصلي إلى سلة المهملات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimido. No se pudo mover el original a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compressé. L’original n’a pas pu être placé dans la Corbeille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस हो गया। मूल फ़ाइल को ट्रैश में नहीं ले जाया जा सका।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimido. Não foi possível mover o original para o Lixo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıkıştırıldı. Orijinal dosya Çöp Sepeti’ne taşınamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已压缩。无法将原始文件移到废纸篓。"
          }
        }
      }
    },
    "Compressing is lossless: games play exactly as before, from smaller files.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الضغط بلا فقدان: تعمل الألعاب تمامًا كما كانت، ولكن من ملفات أصغر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compresión no tiene pérdidas: los juegos funcionan exactamente igual que antes, con archivos más pequeños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compression est sans perte : les jeux fonctionnent exactement comme avant, avec des fichiers plus petits."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस करना लॉसलेस है: गेम छोटी फ़ाइलों से ठीक पहले जैसे ही चलते हैं।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compressão é sem perdas: os jogos rodam exatamente como antes, a partir de arquivos menores."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıkıştırma kayıpsızdır: oyunlar daha küçük dosyalardan, tıpkı eskisi gibi oynanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩是无损的：游戏会以更小的文件运行，体验与之前完全相同。"
          }
        }
      }
    },
