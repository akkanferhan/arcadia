              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kütüphanene %lld oyun eklendi."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Kütüphanene %lld oyun eklendi."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "已将 %lld 款游戏添加到游戏库。"
                }
              }
            }
          }
        }
      }
    },
    "All your games, from the Atari 2600 to the PlayStation 5, in one place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ألعابك، من Atari 2600 إلى PlayStation 5، في مكان واحد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus juegos, del Atari 2600 a la PlayStation 5, en un solo lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous vos jeux, de l’Atari 2600 à la PlayStation 5, au même endroit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atari 2600 से PlayStation 5 तक, आपके सारे गेम एक ही जगह।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os seus jogos, do Atari 2600 ao PlayStation 5, em um só lugar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atari 2600’den PlayStation 5’e tüm oyunların tek bir yerde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Atari 2600 到 PlayStation 5，你的所有游戏尽在一处。"
          }
        }
      }
    },
    "Almost ready": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على وشك الجاهزية"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi listo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque prêt"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग तैयार"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase pronto"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neredeyse hazır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将就绪"
          }
        }
      }
    },
    "Another game is already running.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك لعبة أخرى قيد التشغيل بالفعل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay otro juego en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre jeu est déjà en cours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक और गेम पहले से चल रहा है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro jogo já está em execução."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda başka bir oyun çalışıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有另一个游戏正在运行。"
          }
        }
      }
    },
    "Any PS1 BIOS from your console, such as scph5501.bin. Without it Arcadia uses a built-in BIOS that runs most games.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي ملف BIOS لجهاز PS1 من جهازك، مثل scph5501.bin. بدونه يستخدم Arcadia نظام BIOS مدمجًا يشغّل معظم الألعاب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier BIOS de PS1 de tu consola, como scph5501.bin. Sin ella, Arcadia usa una BIOS integrada que ejecuta la mayoría de los juegos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’importe quel BIOS PS1 de votre console, comme scph5501.bin. Sans lui, Arcadia utilise un BIOS intégré qui fait tourner la plupart des jeux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके कंसोल का कोई भी PS1 BIOS, जैसे scph5501.bin। इसके बिना Arcadia एक बिल्ट-इन BIOS इस्तेमाल करता है जो ज़्यादातर गेम चलाता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer BIOS de PS1 do seu console, como scph5501.bin. Sem ela, o Arcadia usa uma BIOS embutida que roda a maioria dos jogos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsolundan alınmış herhangi bir PS1 BIOS’u (ör. scph5501.bin). Yoksa Arcadia, oyunların çoğunu çalıştıran yerleşik bir BIOS kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自你主机的任意 PS1 BIOS，例如 scph5501.bin。没有它时，Arcadia 会使用能运行大多数游戏的内置 BIOS。"
          }
        }
      }
    },
    "Arcadia could not be sure which console these belong to. Pick one to add them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن Arcadia من تحديد الجهاز الذي تنتمي إليه هذه الألعاب. اختر جهازًا لإضافتها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia no pudo saber a qué consola pertenecen. Elige una para añadirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia n’a pas pu déterminer la console de ces jeux. Choisissez-en une pour les ajouter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia तय नहीं कर सका कि ये किस कंसोल के हैं। जोड़ने के लिए एक चुनें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Arcadia não conseguiu saber de qual console eles são. Escolha um para adicioná-los."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia bunların hangi konsola ait olduğundan emin olamadı. Eklemek için bir konsol seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia 无法确定这些游戏属于哪台主机。选择一个即可添加。"
          }
        }
      }
    },
    "Arcadia looks inside your folders and drives and recognises each game's console.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث Arcadia في مجلداتك وأقراصك ويتعرّف على جهاز كل لعبة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia busca en tus carpetas y discos y reconoce la consola de cada juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia parcourt vos dossiers et disques et reconnaît la console de chaque jeu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia आपके फ़ोल्डरों और ड्राइव में देखता है और हर गेम का कंसोल पहचानता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Arcadia procura nas suas pastas e discos e reconhece o console de cada jogo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia klasörlerine ve disklerine bakar, her oyunun hangi konsola ait olduğunu tanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcadia 会查看你的文件夹和磁盘，并识别每款游戏所属的主机。"
          }
        }
      }
    },
