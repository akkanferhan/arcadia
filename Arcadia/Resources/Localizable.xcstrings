    "Choose where your games live. Arcadia creates a folder for each system.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مكان حفظ ألعابك. ينشئ Arcadia مجلدًا لكل نظام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde guardar tus juegos. Arcadia crea una carpeta para cada sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où ranger vos jeux. Arcadia crée un dossier pour chaque système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि आपके गेम कहाँ रहेंगे। Arcadia हर सिस्टम के लिए एक फ़ोल्डर बनाता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde ficam seus jogos. O Arcadia cria uma pasta para cada sistema."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunlarının duracağı yeri seç. Arcadia her sistem için bir klasör oluşturur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择存放游戏的位置。Arcadia 会为每个平台创建一个文件夹。"
          }
        }
