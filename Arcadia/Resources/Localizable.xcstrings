    "Put your PS2 BIOS in bios/ps2 and select it in PCSX2's first-run setup.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع BIOS جهاز PS2 في bios/ps2 واختره في إعداد التشغيل الأول لـ PCSX2."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tu BIOS de PS2 en bios/ps2 y selecciónala en la configuración inicial de PCSX2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez votre BIOS PS2 dans bios/ps2 et sélectionnez-le lors de la première configuration de PCSX2."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना PS2 BIOS bios/ps2 में रखें और PCSX2 के पहले सेटअप में उसे चुनें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque sua BIOS de PS2 em bios/ps2 e selecione-a na configuração inicial do PCSX2."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PS2 BIOS’unu bios/ps2 klasörüne koy ve PCSX2’nin ilk kurulumunda seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 PS2 BIOS 放入 bios/ps2，并在 PCSX2 首次运行设置中选择它。"
          }
        }
      }
    },
    "Put your games in a system's folder, or drag them onto a console page. Arcadia does the rest.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع ألعابك في مجلد النظام، أو اسحبها إلى صفحة الجهاز. وArcadia يتولى الباقي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tus juegos en la carpeta de un sistema o arrástralos a la página de una consola. Arcadia hace el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez vos jeux dans le dossier d’un système ou glissez-les sur la page d’une console. Arcadia s’occupe du reste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने गेम किसी सिस्टम के फ़ोल्डर में रखें, या उन्हें कंसोल पेज पर खींचें। बाकी काम Arcadia करता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque seus jogos na pasta de um sistema ou arraste-os para a página de um console. O Arcadia faz o resto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunlarını bir sistemin klasörüne koy ya da konsol sayfasına sürükle. Gerisini Arcadia halleder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把游戏放进对应平台的文件夹，或拖到主机页面上，其余的交给 Arcadia。"
          }
        }
      }
    },
