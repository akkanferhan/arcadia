    "Drag game files here, or copy them into the %@ folder.\nSupported: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب ملفات الألعاب إلى هنا، أو انسخها إلى مجلد %1$@.\nالصيغ المدعومة: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra aquí los archivos de juego o cópialos en la carpeta %1$@.\nCompatibles: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez les fichiers de jeu ici ou copiez-les dans le dossier %1$@.\nFormats pris en charge : %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेम फ़ाइलें यहाँ खींचें, या उन्हें %1$@ फ़ोल्डर में कॉपी करें।\nसमर्थित: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os arquivos de jogo para cá ou copie-os para a pasta %1$@.\nFormatos aceitos: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun dosyalarını buraya sürükle ya da %1$@ klasörüne kopyala.\nDesteklenenler: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将游戏文件拖到这里，或复制到 %1$@ 文件夹。\n支持的格式：%2$@"
          }
        }
      }
    },
    "Drag installed game folders here, or copy them into the %@ folder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب مجلدات الألعاب المثبّتة إلى هنا، أو انسخها إلى مجلد %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra aquí las carpetas de juegos instalados o cópialas en la carpeta %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez ici les dossiers de jeux installés ou copiez-les dans le dossier %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉल किए गए गेम फ़ोल्डर यहाँ खींचें, या उन्हें %@ फ़ोल्डर में कॉपी करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as pastas de jogos instalados para cá ou copie-as para a pasta %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü oyun klasörlerini buraya sürükle ya da %@ klasörüne kopyala."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将已安装的游戏文件夹拖到这里，或复制到 %@ 文件夹。"
          }
        }
      }
    },
    "Drop your own game dumps into the folders, or drag them onto Arcadia.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع نسخ ألعابك الخاصة في المجلدات، أو اسحبها إلى Arcadia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tus propias copias de juegos en las carpetas o arrástralas a Arcadia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez vos propres copies de jeux dans les dossiers ou glissez-les sur Arcadia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने गेम डंप फ़ोल्डरों में डालें, या उन्हें Arcadia पर खींचें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque suas próprias cópias de jogos nas pastas ou arraste-as para o Arcadia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi oyun kopyalarını klasörlere koy ya da Arcadia’ya sürükle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你自己转储的游戏放进文件夹，或直接拖到 Arcadia 上。"
          }
        }
      }
    },
