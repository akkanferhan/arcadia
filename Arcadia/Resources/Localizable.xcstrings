    "Double-click a game. Arcadia downloads the right emulator for you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر نقرًا مزدوجًا على لعبة، وسيُنزّل Arcadia المحاكي المناسب لك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en un juego. Arcadia descarga el emulador adecuado por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez sur un jeu. Arcadia télécharge le bon émulateur pour vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी गेम पर डबल-क्लिक करें। Arcadia आपके लिए सही एम्युलेटर डाउनलोड करता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique duas vezes em um jogo. O Arcadia baixa o emulador certo para você."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir oyuna çift tıkla. Arcadia doğru emülatörü senin için indirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击游戏，Arcadia 会为你下载合适的模拟器。"
          }
        }
      }
    },
    "Downloaded from each project's official releases. Arcadia never ships games or BIOS files.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنزَّل من الإصدارات الرسمية لكل مشروع. لا يوفّر Arcadia أي ألعاب أو ملفات BIOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descargan de las versiones oficiales de cada proyecto. Arcadia nunca incluye juegos ni archivos BIOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargés depuis les versions officielles de chaque projet. Arcadia ne fournit jamais de jeux ni de fichiers BIOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर प्रोजेक्ट की आधिकारिक रिलीज़ से डाउनलोड किए जाते हैं। Arcadia कभी गेम या BIOS फ़ाइलें नहीं देता।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixados das versões oficiais de cada projeto. O Arcadia nunca distribui jogos nem arquivos de BIOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her projenin resmî sürümlerinden indirilir. Arcadia asla oyun veya BIOS dosyası dağıtmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从各项目的官方发布页面下载。Arcadia 从不提供游戏或 BIOS 文件。"
          }
        }
      }
    },
