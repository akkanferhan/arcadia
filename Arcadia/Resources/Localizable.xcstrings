          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo comprimido no coincide con el original, así que se conservó el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier compressé ne correspond pas à l’original ; l’original a donc été conservé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस की गई फ़ाइल मूल से मेल नहीं खाती, इसलिए मूल फ़ाइल रखी गई।"
          }
        },
        "pt-BR": {
