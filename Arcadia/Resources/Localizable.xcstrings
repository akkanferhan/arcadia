    "Drag game files here, or copy them into the %@ folder.\nSupported: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب ملفات الألعاب إلى هنا، أو انسخها إلى مجلد %1$@.\nالصيغ المدعومة: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra aquí los archivos de juego o cópialos en la carpeta %1$@.\nCompatibles: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez les fichiers de jeu ici ou copiez-les dans le dossier %1$@.\nFormats pris en charge : %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेम फ़ाइलें यहाँ खींचें, या उन्हें %1$@ फ़ोल्डर में कॉपी करें।\nसमर्थित: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste os arquivos de jogo para cá ou copie-os para a pasta %1$@.\nFormatos aceitos: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun dosyalarını buraya sürükle ya da %1$@ klasörüne kopyala.\nDesteklenenler: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将游戏文件拖到这里，或复制到 %1$@ 文件夹。\n支持的格式：%2$@"
          }
        }
      }
    },
    "Drag game folders or %@ files here, or copy them into the %@ folder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب مجلدات الألعاب أو ملفات %1$@ إلى هنا، أو انسخها إلى مجلد %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra aquí carpetas de juegos o archivos %1$@, o cópialos en la carpeta %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez ici des dossiers de jeux ou des fichiers %1$@, ou copiez-les dans le dossier %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेम फ़ोल्डर या %1$@ फ़ाइलें यहाँ खींचें, या उन्हें %2$@ फ़ोल्डर में कॉपी करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste pastas de jogos ou arquivos %1$@ para cá, ou copie-os para a pasta %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun klasörlerini ya da %1$@ dosyalarını buraya sürükle veya %2$@ klasörüne kopyala."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将游戏文件夹或 %1$@ 文件拖到这里，或复制到 %2$@ 文件夹。"
          }
        }
      }
    },
    "Drag games onto the collection in the sidebar, or choose Collections in a game's menu.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الألعاب إلى المجموعة في الشريط الجانبي، أو اختر المجموعات من قائمة اللعبة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra juegos a la colección en la barra lateral o elige Colecciones en el menú de un juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser des jeux sur la collection dans la barre latérale ou choisissez Collections dans le menu d’un jeu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेम को साइडबार में कलेक्शन पर ड्रैग करें, या किसी गेम के मेनू में कलेक्शन चुनें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste jogos para a coleção na barra lateral ou escolha Coleções no menu de um jogo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunları kenar çubuğundaki koleksiyona sürükle ya da bir oyunun menüsünden Koleksiyonlar’ı seç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将游戏拖到边栏中的合集上，或在游戏的菜单中选择“合集”。"
          }
        }
      }
    },
    "Drag installed game folders here, or copy them into the %@ folder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب مجلدات الألعاب المثبّتة إلى هنا، أو انسخها إلى مجلد %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra aquí las carpetas de juegos instalados o cópialas en la carpeta %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez ici les dossiers de jeux installés ou copiez-les dans le dossier %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉल किए गए गेम फ़ोल्डर यहाँ खींचें, या उन्हें %@ फ़ोल्डर में कॉपी करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as pastas de jogos instalados para cá ou copie-as para a pasta %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü oyun klasörlerini buraya sürükle ya da %@ klasörüne kopyala."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将已安装的游戏文件夹拖到这里，或复制到 %@ 文件夹。"
          }
        }
      }
    },
    "Drop BIOS files dumped from your consoles here. Arcadia puts each one where its emulator looks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفلت هنا ملفات BIOS المستخرجة من أجهزتك، وسيضع Arcadia كل ملف حيث يبحث عنه محاكيه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta aquí los archivos BIOS extraídos de tus consolas. Arcadia coloca cada uno donde lo busca su emulador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez ici les fichiers BIOS extraits de vos consoles. Arcadia place chacun là où son émulateur le cherche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कंसोल से निकाली गई BIOS फ़ाइलें यहाँ छोड़ें। Arcadia हर फ़ाइल को वहाँ रखता है जहाँ उसका एम्युलेटर ढूँढता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte aqui os arquivos de BIOS extraídos dos seus consoles. O Arcadia coloca cada um onde o emulador procura."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsollarından aldığın BIOS dosyalarını buraya bırak. Arcadia her birini emülatörünün aradığı yere koyar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把从你主机转储的 BIOS 文件拖到这里，Arcadia 会把每个文件放到对应模拟器查找的位置。"
          }
        }
      }
    },
    "Drop your own game dumps into the folders, or drag them onto Arcadia.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع نسخ ألعابك الخاصة في المجلدات، أو اسحبها إلى Arcadia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tus propias copias de juegos en las carpetas o arrástralas a Arcadia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez vos propres copies de jeux dans les dossiers ou glissez-les sur Arcadia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने गेम डंप फ़ोल्डरों में डालें, या उन्हें Arcadia पर खींचें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque suas próprias cópias de jogos nas pastas ou arraste-as para o Arcadia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi oyun kopyalarını klasörlere koy ya da Arcadia’ya sürükle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你自己转储的游戏放进文件夹，或直接拖到 Arcadia 上。"
          }
        }
      }
    },
    "Each game is a folder containing eboot.bin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل لعبة عبارة عن مجلد يحتوي على eboot.bin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada juego es una carpeta que contiene eboot.bin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
