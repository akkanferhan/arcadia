          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यूज़रनेम"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome de usuário"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名"
          }
        }
      }
    },
    "Using a built-in BIOS. Add your console's BIOS for the best compatibility.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم نظام BIOS مدمج. أضف BIOS جهازك لأفضل توافق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usando una BIOS integrada. Añade la BIOS de tu consola para la mejor compatibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BIOS intégré utilisé. Ajoutez le BIOS de votre console pour une compatibilité optimale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्ट-इन BIOS इस्तेमाल हो रहा है। सबसे अच्छी संगतता के लिए अपने कंसोल का BIOS जोड़ें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usando uma BIOS embutida. Adicione a BIOS do seu console para melhor compatibilidade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşik BIOS kullanılıyor. En iyi uyumluluk için konsolunun BIOS’unu ekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用内置 BIOS。添加你主机的 BIOS 可获得最佳兼容性。"
          }
        }
      }
    },
    "Vitamin dumps can't be played. Dump the game again with NoNpDrm or FAGDec.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تشغيل النسخ المستخرجة باستخدام Vitamin. استخرج اللعبة مجددًا باستخدام NoNpDrm أو FAGDec."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias hechas con Vitamin no se pueden jugar. Vuelve a extraer el juego con NoNpDrm o FAGDec."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies Vitamin ne peuvent pas être lancées. Extrayez à nouveau le jeu avec NoNpDrm ou FAGDec."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin डंप नहीं चलाए जा सकते। गेम को NoNpDrm या FAGDec से फिर से डंप करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias feitas com o Vitamin não podem ser jogadas. Extraia o jogo novamente com o NoNpDrm ou o FAGDec."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin ile alınmış kopyalar oynatılamaz. Oyunu NoNpDrm ya da FAGDec ile yeniden al."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitamin 转储无法游玩。请用 NoNpDrm 或 FAGDec 重新转储游戏。"
          }
        }
      }
    },
    "Waiting": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الانتظار"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En espera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतीक्षा में"
          }
        },
        "pt-BR": {
